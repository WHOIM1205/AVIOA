# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored so secrets never reach GitHub.

# PostgreSQL connection string (we create this database in Phase 1)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/aivoa

# Groq API key — created for free at https://console.groq.com (we do this in Phase 2)
GROQ_API_KEY=your_groq_api_key_here

# Model. The assignment asks for gemma2-9b-it, but Groq has decommissioned it,
# so we use the assignment's named alternative. Swap here if Groq's lineup changes.
GROQ_MODEL=llama-3.3-70b-versatile
